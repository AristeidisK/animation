# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This template is committed
# so there is one documented home for every credential the project needs.
#
# Load it in a shell with:
#   set -a && source .env && set +a

# --- Jira (personal account, leavalley site) ---------------------------------
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token with scopes" — read:jira-work, write:jira-work only.
# Sign in as the PERSONAL account, not CEPR. A private window avoids mix-ups.
JIRA_SITE=https://leavalley.atlassian.net
JIRA_EMAIL=aristeidis.koliopoulos@gmail.com
JIRA_TOKEN=

# --- ElevenLabs — narration, English + Greek ---------------------------------
# Needed for Gate 0. Free tier is enough for the narration test.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- fal.ai — image and video generation -------------------------------------
# Not needed until Gate 1. Pay-as-you-go credits, no subscription.
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- YouTube Data API — programmatic upload ----------------------------------
# Not needed until there is something to publish. Create under the DEDICATED
# channel Google account, never the work or main personal one.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
